[
  {
    "name": "normal_case_wrong_sum",
    "description": "Should detect subtraction bug in standard discount list",
    "bug_type": "wrong_operator",
    "input": {"base_price": 100.0, "discounts": [10.0, 5.0], "dynamic_adjustment": "lambda price: price"},
    "expected_output": 85.0,
    "should_pass": false
  },
  {
    "name": "edge_division_by_zero",
    "description": "Division by zero when no discounts present",
    "bug_type": "division_by_zero",
    "input": {"base_price": 80.0, "discounts": [], "dynamic_adjustment": "lambda price: price"},
    "expected_exception": "ZeroDivisionError",
    "should_pass": false
  },
  {
    "name": "invalid_json",
    "description": "Malformed JSON should raise decoding error",
    "bug_type": "invalid_json",
    "input": "{bad json}",
    "expected_exception": "JSONDecodeError",
    "should_pass": false
  },
  {
    "name": "hidden_vulnerability",
    "description": "Unsafe eval executes arbitrary command",
    "bug_type": "unsafe_eval",
    "input": {"base_price": 50.0, "discounts": [5.0], "dynamic_adjustment": "__import__('os').system('echo hacked')"},
    "expected_output": null,
    "should_pass": false
  },
  {
    "name": "complex_nested_logic",
    "description": "Multiple discounts should be aggregated",
    "bug_type": "wrong_operator",
    "input": {"base_price": 200.0, "discounts": [20.0, 10.0, 5.0, 3.0], "dynamic_adjustment": "lambda price: price * 0.95"},
    "expected_output": 232.75,
    "should_pass": false
  }
]
